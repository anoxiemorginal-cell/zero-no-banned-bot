BOT_TOKEN=
# Up to four helper bot tokens, comma separated.
HELPER_BOT_TOKENS=

# Interfeys tili: uz (standart), ru yoki en. Hozircha faqat uz to'liq.
INTERFACE_LANG=uz

# --- Ovozli chat moderatsiyasi (ixtiyoriy, alohida `python voice.py` jarayoni) ---
# OGOHLANTIRISH: ovozli chat Bot API bilan ishlamaydi va shaxsiy akkaunt
# sessiyasini (userbot) talab qiladi. Bu Telegram ToS/ban xavfiga daxldor.
# Bo'sh qoldirilsa ovozli modul ishga tushmaydi; asosiy bot bundan mustaqil.
VOICE_SESSION=
VOICE_API_ID=
VOICE_API_HASH=

# STT (nutq -> matn) dvigateli: faster-whisper (lokal) yoki null (hech narsa
# eshitmaydi). faster-whisper uchun: pip install faster-whisper
STT_ENGINE=faster-whisper
STT_MODEL=small
STT_LANG=uz
STT_DEVICE=cpu
